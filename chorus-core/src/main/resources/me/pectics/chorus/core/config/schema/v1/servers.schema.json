{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chorus:configuration:servers:v1",
  "$comment": "The complete servers.yml v1 format contract. See ARCHITECTURE.md section 3.9. Configured server nodes do not grant issuer trust.",
  "title": "Chorus server node list configuration v1",
  "type": "object",
  "propertyNames": {
    "$ref": "#/$defs/nodeId"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "address"
    ],
    "properties": {
      "address": {
        "type": "string",
        "description": "Client-visible hostname or IPv4 plus port, or bracketed IPv6 plus port. Port is a decimal integer in 1..65535; no DNS resolution is performed.",
        "pattern": "^(?:[^:\\[\\]\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]+|\\[(?=[^\\]]*:)[0-9A-Fa-f:.]+(?:%[A-Za-z0-9_.~-]+)?\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$(?![\\s\\S])"
      },
      "display-name": {
        "$ref": "#/$defs/nonBlankString",
        "description": "Optional display label. Runtime assembly uses the node ID when absent."
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$(?![\\s\\S])"
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
    }
  }
}
