{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chorus:configuration:chorus:v1",
  "$comment": "The complete chorus.yml v1 format contract. See ARCHITECTURE.md section 3.9. TODO: REGISTRY/REDIS replay backends are reserved and rejected by runtime assembly until implemented.",
  "title": "Chorus configuration v1",
  "description": "File-based Core configuration with explicit operational limits. Assembly checks duration arithmetic, field relationships, implemented options, key contents, and directory references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["node", "ticket", "crypto", "registry", "verification"],
  "properties": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "display-name": {
          "$ref": "#/$defs/nonBlankString",
          "description": "Descriptive local label only. Core does not consume it; runtime directory display names come from servers.yml."
        },
        "role": {
          "description": "GATEWAY sends tickets, BACKEND receives tickets, and PEER supports both operations.",
          "enum": ["GATEWAY", "BACKEND", "PEER"]
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cookie-key", "max-payload-bytes", "max-property-bytes"],
      "properties": {
        "cookie-key": {
          "description": "The namespaced Minecraft Cookie key shared by sender and receiver.",
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$(?![\\s\\S])"
        },
        "max-payload-bytes": {
          "type": "integer", "minimum": 1, "maximum": 5120,
          "description": "Maximum complete Cookie payload, including the signed JWS and any compression frame."
        },
        "max-property-bytes": {
          "type": "integer", "minimum": 1, "maximum": 5120,
          "description": "UTF-8 profile property budget. Must not exceed max-payload-bytes."
        },
        "compression": {
          "enum": ["NONE", "ZSTD", "GZIP"],
          "default": "ZSTD",
          "description": "Outgoing encoding; omitted means ZSTD. Receivers accept NONE, ZSTD, and GZIP. Compression wraps the complete signed JWS in a versioned frame; decompressed JWS is bounded to 64 KiB."
        }
      }
    },
    "crypto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm"],
      "properties": {
        "algorithm": {
          "enum": ["ED25519", "HMAC_SHA256"],
          "description": "Local signing algorithm. Each trusted issuer independently specifies its verification algorithm."
        },
        "key": {
          "$ref": "#/$defs/nonBlankString",
          "description": "Raw 32-byte HMAC-SHA256 secret path relative to chorus.yml. Required for HMAC senders; generated only if missing. Distribute the same file to trusted receivers."
        },
        "private-key": {
          "$ref": "#/$defs/nonBlankString",
          "description": "PKCS#8 Ed25519 private key path relative to chorus.yml. Required for sender."
        },
        "public-key": {
          "$ref": "#/$defs/nonBlankString",
          "description": "Matching X.509 SPKI public key path relative to chorus.yml. Required for sender."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"algorithm": {"const": "ED25519"}}},
          "then": {"not": {"required": ["key"]}},
          "else": {"not": {"anyOf": [{"required": ["private-key"]}, {"required": ["public-key"]}]}}
        }
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "config"
      ],
      "properties": {
        "provider": {
          "enum": [
            "CONFIG",
            "SQL"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuers-path"
          ],
          "properties": {
            "servers-path": {
              "$ref": "#/$defs/nonBlankString",
              "description": "Directory path relative to chorus.yml, validated with servers.schema.json."
            },
            "issuers-path": {
              "$ref": "#/$defs/nonBlankString",
              "description": "Local trust path relative to chorus.yml, used by both CONFIG and SQL; keys are never synchronized through SQL."
            }
          }
        },
        "sql": {
          "$comment": "TODO: SQL routing implementation is pending. TODO: PostgreSQL sql.schema and future write-account separation remain undecided (ARCHITECTURE.md section 7.2).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "host",
            "port",
            "database",
            "username",
            "password-path",
            "tls",
            "pool",
            "timeouts"
          ],
          "properties": {
            "engine": {
              "enum": [
                "POSTGRESQL",
                "MYSQL",
                "MARIADB"
              ]
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])",
              "description": "ASCII DNS name, IPv4, or unbracketed IPv6; no URL or connection parameters."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "$ref": "#/$defs/nonBlankString"
            },
            "username": {
              "$ref": "#/$defs/nonBlankString"
            },
            "password-path": {
              "$ref": "#/$defs/nonBlankString",
              "description": "UTF-8 password file relative to chorus.yml; one trailing LF or CRLF is removed, other whitespace is preserved."
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "DISABLED",
                    "VERIFY_FULL"
                  ]
                },
                "ca-cert": {
                  "$ref": "#/$defs/nonBlankString",
                  "description": "Optional PEM CA bundle path relative to chorus.yml. Omitted uses the JVM default truststore."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "DISABLED"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "ca-cert"
                      ]
                    }
                  }
                }
              ]
            },
            "pool": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max-connections",
                "acquire-timeout"
              ],
              "properties": {
                "max-connections": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "acquire-timeout": {
                  "$ref": "#/$defs/duration",
                  "description": "Whole milliseconds in 500..2147483647; waits for the pool, independently of physical connect timeout."
                }
              }
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "connect",
                "query",
                "socket"
              ],
              "properties": {
                "connect": {
                  "$ref": "#/$defs/duration",
                  "description": "Positive whole milliseconds fitting 1..2147483647. Driver seconds round upward; query applies per statement."
                },
                "query": {
                  "$ref": "#/$defs/duration",
                  "description": "Positive whole milliseconds fitting 1..2147483647. Driver seconds round upward; query applies per statement."
                },
                "socket": {
                  "$ref": "#/$defs/duration",
                  "description": "Positive whole milliseconds fitting 1..2147483647. Driver seconds round upward; query applies per statement."
                }
              }
            }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refresh-interval",
            "max-stale"
          ],
          "properties": {
            "refresh-interval": {
              "$ref": "#/$defs/duration"
            },
            "max-stale": {
              "$ref": "#/$defs/duration",
              "description": "Hard age limit since the last successful SQL server snapshot; must exceed refresh-interval. Failed refreshes never extend it. Local trust does not expire."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "CONFIG"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "required": [
                  "servers-path"
                ]
              }
            }
          },
          "else": {
            "required": [
              "sql",
              "cache"
            ]
          }
        }
      ]
    },
    "issuance": {
      "description": "Sender permissions and lifetime. Receivers independently enforce their trust policies.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "allowed-auth-schemes", "allowed-providers", "allowed-targets"],
      "properties": {
        "ttl": {
          "$ref": "#/$defs/wholeSecondDuration",
          "description": "Positive whole-second lifetime, no greater than verification.max-lifetime."
        },
        "allowed-auth-schemes": {
          "$comment": "TODO: YGGDRASIL and FLOODGATE identity flows are not implemented. The Phase-1 engine rejects those schemes even when listed in a policy.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["MOJANG", "OFFLINE_AUTH", "OFFLINE_RAW", "YGGDRASIL", "FLOODGATE"]}
        },
        "allowed-providers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$(?![\\s\\S])"}
        },
        "allowed-targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max-lifetime", "clock-skew", "enforce-transfer-intent", "identity-policy"],
      "properties": {
        "max-lifetime": {
          "$ref": "#/$defs/wholeSecondDuration",
          "description": "Positive maximum accepted lifetime in whole seconds. Must cover issuance.ttl when sending."
        },
        "clock-skew": {
          "$ref": "#/$defs/wholeSecondDuration",
          "description": "Nonnegative whole-second allowance bound to the replay database."
        },
        "enforce-transfer-intent": {"type": "boolean"},
        "identity-policy": {"enum": ["ADOPT_UPSTREAM", "FORCE_OFFLINE_UUID", "STRICT_ONLINE_MATCH"]},
        "ip-binding": {"const": "DISABLED"}
      }
    },
    "replay-guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": {
          "enum": ["LOCAL", "REGISTRY", "REDIS"],
          "$comment": "TODO: Implement REGISTRY using the registry database and implement REDIS. Only LOCAL is operational. REGISTRY is invalid with registry.provider CONFIG."
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "max-entries", "busy-timeout"],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonBlankString",
              "description": "Persistent SQLite path relative to chorus.yml. Preserve the database and WAL."
            },
            "max-entries": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "busy-timeout": {
              "$ref": "#/$defs/duration",
              "description": "Positive lock wait whose whole milliseconds fit 1..2147483647."
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "TODO: Define Redis settings together with the Redis ReplayGuard implementation. This empty placeholder does not enable that backend."
        }
      },
      "allOf": [
        {"if": {"properties": {"backend": {"const": "LOCAL"}}}, "then": {"required": ["local"]}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"node": {"properties": {"role": {"enum": ["GATEWAY", "PEER"]}}}}},
      "then": {
        "required": ["issuance"],
        "properties": {
          "crypto": {
            "if": {"properties": {"algorithm": {"const": "ED25519"}}},
            "then": {"required": ["private-key", "public-key"]},
            "else": {"required": ["key"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"node": {"properties": {"role": {"enum": ["BACKEND", "PEER"]}}}}},
      "then": {"required": ["replay-guard"]}
    },
    {
      "$comment": "Registry replay cannot use the CONFIG file provider.",
      "if": {
        "required": ["replay-guard"],
        "properties": {"replay-guard": {"properties": {"backend": {"const": "REGISTRY"}}}}
      },
      "then": {"properties": {"registry": {"properties": {"provider": {"not": {"const": "CONFIG"}}}}}}
    }
  ],
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$(?![\\s\\S])"
    },
    "duration": {
      "description": "An unsigned integer followed by ms, s, m, or h, or the Java Duration ISO-8601 syntax. Range and normalized sign are checked during conversion.",
      "type": "string",
      "pattern": "^(?:[0-9]+(?:ms|s|m|h)|[+-]?[Pp](?=[+-]?[0-9]+[Dd]|[Tt])(?:[+-]?[0-9]+[Dd])?(?:[Tt](?=[+-]?[0-9])(?:[+-]?[0-9]+[Hh])?(?:[+-]?[0-9]+[Mm])?(?:[+-]?[0-9]+(?:[.,][0-9]{0,9})?[Ss])?)?)$(?![\\s\\S])"
    },
    "wholeSecondDuration": {
      "$ref": "#/$defs/duration",
      "description": "Whole-second precision, including exact multiples of 1000ms and ISO fractions containing only zeroes.",
      "allOf": [
        {"not": {"pattern": "[.,][0-9]*[1-9]"}},
        {"if": {"pattern": "ms$"}, "then": {"pattern": "^(?:0+|[0-9]+000)ms$(?![\\s\\S])"}}
      ]
    }
  }
}
